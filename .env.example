# Use your Ubuntu server's LAN IP. No router port forwarding.
HOST=192.168.0.151
PORT=4180
DEV_WEB_PORT=4180
DEV_API_PORT=4181
LOG_LEVEL=info
DATA_MODE=postgres
# Generate two DIFFERENT random secrets, e.g. openssl rand -hex 24.
ADMIN_PASSWORD=REPLACE_WITH_OWNER_PASSWORD_AT_LEAST_12_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_DIFFERENT_DATABASE_PASSWORD
DATABASE_URL=postgresql://donarium:REPLACE_WITH_DIFFERENT_DATABASE_PASSWORD@db:5432/donarium
# For host development use 127.0.0.1:5548 instead of db:5432.
# Only set for local HTTPS. HTTP LAN requires false.
SECURE_COOKIE=false
# Logical keys + paths INSIDE the app container. External roots must also be mounted read-only.
STORAGE_ROOTS=[]
# Example: [{"key":"MODELS","name":"Модели","path":"/library/models"}]
# Host directories for Docker bind mounts and backup. Use large disks for large exports.
# If container and host root paths differ, use host paths for the host backup script:
# BACKUP_STORAGE_ROOTS=[{"key":"MODELS","path":"/mnt/your-model-library"}]
MANAGED_STORAGE_ROOT=var/uploads
WORK_ROOT=var/work
MAX_UPLOAD_BYTES=21474836480
MAX_ARCHIVE_BYTES=2199023255552
# Set only for migration commands after verifying the dedicated DATABASE_URL:
# DB_MIGRATION_CONFIRM=donarium
