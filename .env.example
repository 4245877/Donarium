# Bind only to your LAN interface. Get it with: ip -br -4 addr
HOST=192.168.0.151
PORT=4180
DEV_WEB_PORT=4180
DEV_API_PORT=4181
LOG_LEVEL=info
DATA_MODE=demo
# Dedicated DONARIUM DB only. Never use SKUFnya credentials.
# DATABASE_URL=postgresql://donarium:CHANGE_ME@127.0.0.1:5548/donarium
# Explicit confirmation for db:migrate and db:seed; do not leave enabled routinely.
# DB_MIGRATION_CONFIRM=donarium
# Docker optional database profile (set only when enabling PostgreSQL):
# POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
# Existing remote files: URL base WITHOUT credentials. Keep relative paths in the DB.
# Reserved base configuration; relative-path URL resolver is a future module.
# Direct links in assets.external_url work already.
# EXTERNAL_STORAGE_BASE_URL=https://files.example.lan/library/
# STORAGE_ROOT=/srv/donarium/files
